---
import { COLORS } from "../../data/colors";
import { RESSOURCES } from "../../data/ressources";
import type { IdRessource } from "../IdRessource";
import RessourcesSvgSwitch from "../svg/RessourcesSvgSwitch.astro";
import SvgStock from "../svg/stock/SvgStock.astro";
import SvgStockIndividuel from "../svg/stock/SvgStockIndividuel.astro";
import SvgCycle from "../../svg/SvgCycle.astro";
import SwitchResumeRessources from "../resumes/SwitchResumeRessources.astro";

interface Props {
  id: IdRessource;
}

const { id } = Astro.props;
const ressource = RESSOURCES[id];
const couleur = COLORS[ressource.color];

const svgProps = { size: "2em" };

const temporaliteSquares = ressource.temporalite
  ? Array.from({ length: ressource.temporalite - 1 }, (_, i) => i + 2)
  : [];
---

<div class="barrette" style={`background-color: ${couleur.hexa}`}>
  <div
    class="ressource-header"
    style={`color: ${couleur.textWhite ? "white" : "black"}`}
  >
    <div class="ressource-titre">
      <RessourcesSvgSwitch
        id={id}
        size="1.8em"
        fill={couleur.textWhite ? "white" : "black"}
      />
      <h3>{RESSOURCES[id].plural || RESSOURCES[id].name}</h3>
    </div>
    <div class="small ressource-portee">
      {ressource.stockGlobal ? "Globale" : "Partagée"}
    </div>
  </div>
  <div
    class="small resume"
    style={{ color: couleur.textWhite ? "white" : "black" }}
  >
    <SwitchResumeRessources id={id} />
  </div>
  <div class="ressource-contenu">
    {temporaliteSquares.map((label) => <div class="tempo">{label}</div>)}
    {
      ressource.stockGlobal && (
        <div class="barrette-ligne">
          <SvgStock {...svgProps} />
        </div>
      )
    }
    {
      ressource.parCycle && (
        <div class="barrette-ligne">
          <SvgCycle {...svgProps} />
        </div>
      )
    }
  </div>
</div>

<style>
  .barrette {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
    padding: 6px;
    width: 265px;
    height: max-content;
  }
  .ressource-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    padding: 6px 0 2px;
  }
  .ressource-titre {
    display: flex;
    align-items: center;
    gap: 8px;
    > h3 {
      margin: 0;
    }
  }
  .ressource-portee {
    text-align: right;
    white-space: nowrap;
  }
  .resume {
    padding: 0 4px;
  }
  .ressource-contenu {
    display: flex;
    gap: 6px;
    flex-direction: column;
    > div {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 48px;
      background-color: white;
      border-radius: 4px;
    }
  }
  .tempo {
    font-family: "charlevoix";
    font-size: 1.4em;
  }
</style>

<style is:global>
  .resume > p {
    margin-top: 0;
    margin-bottom: 0.5em;
    > svg {
      margin-bottom: -3px;
    }
  }
</style>
