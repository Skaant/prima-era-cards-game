---
import type { Deck } from "../../_types/Deck";
import { TOUTES_CARTES } from "../../toutes-cartes";
import CarteLine from "./../CarteLine/CarteLine.astro";

interface Props {
  deck: Deck;
}

const { deck } = Astro.props;
const cartes = deck.map(({ id, quantite }) => ({
  id,
  quantite,
  carte: TOUTES_CARTES[id],
}));
---

<div>{cartes.length} cartes</div>
<div class="liste-cartes-wrapper">
  <table class="liste-cartes">
    <thead>
      <tr>
        <th>carte</th>
        <th>quantité</th>
        <th>prérequis</th>
        <th>coûts</th>
        <th>gains</th>
        <th>actions</th>
        <th>notes & histoire</th>
      </tr>
    </thead>
    <tbody>
      {cartes.map(({ id, carte, quantite }) => <CarteLine {id} {carte} {quantite} />)}
    </tbody>
  </table>
</div>

<style>
  .liste-cartes-wrapper {
    overflow-x: auto;
  }
  .liste-cartes {
    width: 100%;
    font-size: 0.85em;
    th {
      text-transform: uppercase;
      opacity: 0.8;
      padding: 0.8em;
    }
  }
</style>
