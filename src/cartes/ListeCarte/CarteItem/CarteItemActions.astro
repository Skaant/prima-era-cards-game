---
import { COLORS } from "../../../data/colors";
import type { IdColor } from "../../../data/IdColor";
import DynamicString from "../../../_components/DynamicString/DynamicString.astro";
import type { Carte } from "../../_types/Carte";
import CarteItemCouts from "./CarteItemCouts.astro";
import CarteItemGains from "./gains/CarteItemGains.astro";

interface Props {
  actions: Carte["actions"];
  couleur: IdColor;
}

const { actions, couleur } = Astro.props;
---

{
  actions && actions.length > 0 && (
    <ul class="actions">
      {actions.map(({ nom, couts, gains, notes }) => (
        <li class="action">
          <div>
            <span
              style={`color: ${COLORS[couleur].textWhite ? "white" : "black"}`}
            >
              {nom}
            </span>
            <ul>
              <CarteItemCouts couts={couts} />
            </ul>
            <span>→</span>
          </div>
          <ul>
            <CarteItemGains gains={gains} />
          </ul>
          {notes && (
            <div class="notes">
              {notes.map((note) => (
                <DynamicString value={note} />
              ))}
            </div>
          )}
        </li>
      ))}
    </ul>
  )
}

<style>
  .actions {
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 0 !important;
  }
  .action {
    border: 3px solid #fffb;
    padding: 3px 8px 2px;
    > :first-child {
      display: flex;
      align-items: center;
      gap: 6px;
      padding-bottom: 4px;
      margin-bottom: 4px;
      border-bottom: solid 3px #fffb;
    }
    + .action {
      margin-top: 6px;
    }
    > :first-child {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      padding-bottom: 6px;
      box-sizing: border-box;
      > span:first-child {
        font-family: "pangaia";
      }
      > :last-child {
        flex-grow: 1;
      }
    }
    > :nth-child(2) {
      padding: 2px 0 4px;
    }
  }
  .notes {
    margin-top: -6px;
    padding: 4px;
    line-height: 1em;
  }
</style>
