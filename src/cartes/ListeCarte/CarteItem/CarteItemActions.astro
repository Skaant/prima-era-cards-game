---
import { COLORS } from "../../../data/colors";
import type { IdColor } from "../../../data/IdColor";
import Ressource from "../../../ressources/Ressource.astro";
import DynamicString from "../../../semantique/DynamicString/DynamicString.astro";
import type { Carte } from "../../_types/Carte";
import type { IdCartes } from "../../paquets/IdCartes";
import CarteItemCouts from "./CarteItemCouts.astro";
import CarteItemGains from "./CarteItemGains.astro";

interface Props {
  id: IdCartes;
  actions: Carte["actions"];
  couleur: IdColor;
}

const { id, actions, couleur } = Astro.props;
---

{
  actions && actions.length > 0 && (
    <ul class="actions">
      {actions.map(({ nom, couts, gains, notes, fois }, index) => (
        <li class="action">
          <div class="action-cadre">
            <button
              type="button"
              class="action-bouton"
              data-action-carte={id}
              data-action-index={index}
            >
              <span>{nom}</span>
              <CarteItemCouts couts={couts} />
            </button>
            {/* Hors du bouton : les boutons radio du choix "or" ne peuvent pas être imbriqués dedans. */}
            <div class="action-gains">
              <CarteItemGains gains={gains} {id} actionIndex={index} />
            </div>
            {fois && (
              <div class="fois">
                Max {fois.value} fois
                {fois.parRessource && (
                  <>
                    /{" "}
                    {fois.parRessource.value ? `${fois.parRessource.value}` : ""}
                    <Ressource
                      id={fois.parRessource.id}
                      plural={
                        (fois.parRessource.value &&
                          fois.parRessource.value > 1) ||
                        undefined
                      }
                    />
                  </>
                )}
                / cycle
              </div>
            )}
          </div>
          {notes && (
            <div class="notes">
              {notes.map((note) => (
                <DynamicString value={note} />
              ))}
            </div>
          )}
        </li>
      ))}
    </ul>
  )
}

<style>
  .actions {
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 0 !important;
  }
  .action {
    + .action {
      margin-top: 6px;
    }
  }
  .action-cadre {
    border: 2px solid black;
    border-radius: 5px;
    padding: 4px 6px;
    box-sizing: border-box;
    &:has(.action-bouton:disabled) {
      opacity: 0.5;
    }
  }
  .action-bouton {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
    padding: 0 0 6px;
    border: none;
    font: inherit;
    text-align: inherit;
    color: inherit;
    background: none;
    box-sizing: border-box;
    cursor: pointer;
    > span {
      font-family: "charlevoix";
    }
    &:disabled {
      cursor: not-allowed;
    }
  }
  .action-gains {
    padding: 2px 4px 4px;
  }
  .notes {
    margin-top: -6px;
    padding: 4px;
    line-height: 1em;
  }
  .fois {
    margin-top: 2px;
    font-size: 0.85em;
  }
</style>
