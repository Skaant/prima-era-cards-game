---
import Ressource from "../../../ressources/Ressource.astro";
import Tribu from "../../../tribus/Tribu.astro";
import StockSvgSwitch from "../../../ressources/svg/stock/StockSvgSwitch.astro";
import SvgStockIndividuel from "../../../ressources/svg/stock/SvgStockIndividuel.astro";
import DynamicString from "../../../semantique/DynamicString/DynamicString.astro";
import type { IdTribu } from "../../../tribus/IdTribu";
import type { Carte } from "../../_types/Carte";
import CarteItemPrerequis from "./CarteItemPrerequis.astro";
import CarteItemOn from "./CarteItemOn.astro";
import SvgStock from "../../../ressources/svg/stock/SvgStock.astro";
import SvgLogement from "../../type-carte/svg/SvgLogement.astro";
import type { IdCartes } from "../../paquets/IdCartes";

interface Props {
  gains: Carte["gains"];
  /** Requis pour rendre sélectionnables les gains `autres` de type `"or"` (boutons radio). */
  id?: IdCartes;
  /** Index de l'action dont ce sont les gains (le choix "or" porte alors sur cette action). */
  actionIndex?: number;
}

const { gains, id, actionIndex } = Astro.props;

const ressources = gains?.ressources?.filter(
  (ress) => !ress.stock || (!ress.stockIndividuel && ress.id !== "branches"),
);

// Une ligne par ressource : gain, stock et gain par cycle d'une même ressource sont regroupés.
const groupes = Object.values(
  (ressources ?? []).reduce<Record<string, NonNullable<typeof ressources>>>(
    (acc, ress) => {
      (acc[ress.id] ??= []).push(ress);
      return acc;
    },
    {},
  ),
);
---

<div class="gains">
  {
    gains &&
      ((gains.tribus?.length || 0) > 0 ||
        (ressources && ressources.length > 0) ||
        (gains.autres && gains.autres.length > 0)) && (
        <>
          {gains.tribus && gains.tribus.length > 0 && (
            <ul class="gains-tribus">
              {gains.tribus.map(({ id: idTribu, value, parCycle, parRessource, prerequis }) => (
                <li>
                  {prerequis && (
                    <div class="inline-prerequis">
                      <CarteItemPrerequis {prerequis} /> :
                    </div>
                  )}
                  +{value}{" "}
                  <Tribu id={idTribu as IdTribu} plural={value > 1 || undefined} />
                  {parRessource && (
                    <>
                      / {parRessource.value ? `${parRessource.value}` : ""}{" "}
                      {parRessource.stockIndividuel && (
                        <>
                          <SvgStockIndividuel />{" "}
                        </>
                      )}
                      <Ressource
                        id={parRessource.id}
                        plural={
                          (parRessource.value && parRessource.value > 1) ||
                          undefined
                        }
                      />
                    </>
                  )}
                  {parCycle && <span>/ cycle</span>}
                </li>
              ))}
            </ul>
          )}
          {ressources && ressources.length > 0 && (
            <ul class="gains-ressources">
              {groupes.map((groupe) => (
                <li class="groupe-ressource">
                  {groupe.map((ress) => (
                    <span class="gain-ressource">
                    {"prerequis" in ress && ress.prerequis && (
                      <>
                        <div class="inline-prerequis">
                          <CarteItemPrerequis prerequis={ress.prerequis} /> :
                        </div>
                      </>
                    )}
                    {`${
                      ress.value &&
                      !("stockIndividuel" in ress) &&
                      ress.value > 0
                        ? "+"
                        : ""
                    }${ress.value}`}
                    {("stockIndividuel" in ress &&
                      ress.stockIndividuel &&
                      (ress.stockIndividuel === true ? (
                        <StockSvgSwitch type="indiv" />
                      ) : ress.stockIndividuel === "in" ? (
                        <StockSvgSwitch type="indiv-in" />
                      ) : (
                        <StockSvgSwitch type="indiv-out" />
                      ))) ||
                      (ress.stock &&
                        (ress.id === "zums" ? (
                          <SvgLogement />
                        ) : (
                          <StockSvgSwitch />
                        )))}
                    <Ressource
                      id={ress.id}
                      plural={
                        ress.value && (ress.value > 1 || ress.value < -1)
                          ? true
                          : undefined
                      }
                    />
                    {"parRessource" in ress && ress.parRessource && (
                      <>
                        /{" "}
                        {ress.parRessource.value
                          ? `${ress.parRessource.value}`
                          : ""}{" "}
                        {ress.parRessource.stock && (
                          <>
                            <SvgStock />{" "}
                          </>
                        )}
                        {ress.parRessource.stockIndividuel && (
                          <>
                            <SvgStockIndividuel />{" "}
                          </>
                        )}
                        <Ressource
                          id={ress.parRessource.id}
                          plural={
                            (ress.parRessource.value &&
                              ress.parRessource.value > 1) ||
                            undefined
                          }
                        />
                      </>
                    )}
                    {"parCycle" in ress && <span>/ cycle</span>}
                    </span>
                  ))}
                </li>
              ))}
            </ul>
          )}
          {gains.autres && gains.autres.length > 0 && (
            <ul class="autres">
              {gains.autres.map((autre, autreIndex) => (
                <li>
                  {typeof autre === "string" ? (
                    <DynamicString value={autre} />
                  ) : autre.type === "on" ? (
                    <CarteItemOn on={autre} {id} {autreIndex} />
                  ) : (
                    <>
                      {id ? (
                        <fieldset
                          class="gain-or"
                          data-or-carte={id}
                          data-or-index={autreIndex}
                          data-or-action={actionIndex}
                        >
                          {autre.resources.map(({ id: idRessource, value }, index) => (
                            <label class="gain-or-option">
                              <input
                                type="radio"
                                data-or-ressource={idRessource}
                                checked={index === 0}
                              />
                              {value > 0 ? "+" : ""}
                              {value}{" "}
                              <Ressource
                                id={idRessource}
                                plural={Math.abs(value) > 1 || undefined}
                              />
                            </label>
                          ))}
                        </fieldset>
                      ) : (
                        <>
                          (
                          {autre.resources.map(({ id: idRessource, value }, index) => (
                            <>
                              {index > 0 && " ou "}
                              {value > 0 ? "+" : ""}
                              {value}{" "}
                              <Ressource
                                id={idRessource}
                                plural={Math.abs(value) > 1 || undefined}
                              />
                            </>
                          ))}
                          )
                        </>
                      )}
                      {autre.parCycle && <span>/ cycle</span>}
                    </>
                  )}
                </li>
              ))}
            </ul>
          )}
        </>
      )
  }
</div>

<style>
  .gains {
    display: flex;
    flex-direction: column;
    gap: 4px;
    :global(.prerequis) {
      padding: 0;
      ul {
        display: flex;
      }
      li {
        display: flex;
        align-items: center;
        gap: 4px;
      }
    }
    > ul {
      gap: 2px;
      flex-wrap: wrap;
      gap: 2px;
      justify-content: start;
      flex-direction: column;
      &.autres {
        margin-top: 0;
      }
      + ul {
        margin-top: 2px;
      }
      > li {
        display: flex;
        align-items: center;
        gap: 0 2px;
        flex-wrap: wrap;
        line-height: 1em;
        .gain-ressource {
          display: inline-flex;
          align-items: center;
          gap: 0 2px;
          flex-wrap: wrap;
        }
        &.groupe-ressource {
          gap: 2px 8px;
        }
        .inline-prerequis {
          display: flex;
          align-items: center;
          gap: 4px;
        }
      }
    }
  }
  .gain-or {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 8px;
    border: none;
    padding: 0;
    margin: 0;
  }
  .gain-or-option {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    cursor: pointer;
    input {
      margin: 0 2px 0 0;
      cursor: pointer;
    }
  }
</style>
