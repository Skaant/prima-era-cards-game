---
import type { Deck } from "../../_types/Deck";
import { TOUTES_CARTES } from "../../toutes-cartes";
import CarteItem from "./CarteItem.astro";

interface Props {
  deck: Deck;
}

const { deck } = Astro.props;
const cartes = deck.flatMap(({ id, quantite }) =>
  Array.from({ length: quantite }, () => ({ id, carte: TOUTES_CARTES[id] })),
);
---

<div>{cartes.length} cartes</div>
<div class="liste-cartes">
  {cartes.map(({ id, carte }) => <CarteItem {id} {carte} />)}
</div>

<style>
  .liste-cartes {
    display: flex;
    gap: 2px;
    flex-wrap: wrap;
  }
</style>
