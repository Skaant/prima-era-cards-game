---
import type { Paquet } from "../../_types/Paquet";
import { TOUTES_CARTES } from "../../paquets/toutes.cartes";
import CarteItem from "./CarteItem.astro";

interface Props {
  paquet: Paquet;
}

const { paquet } = Astro.props;
const cartes = paquet.flatMap(({ id, quantite }) =>
  Array.from({ length: quantite }, () => ({ id, carte: TOUTES_CARTES[id] })),
);
---

<div>{cartes.length} cartes</div>
<div class="liste-cartes">
  {cartes.map(({ id, carte }) => <CarteItem {id} {carte} />)}
</div>

<style>
  .liste-cartes {
    display: flex;
    gap: 2px;
    flex-wrap: wrap;
  }
</style>
