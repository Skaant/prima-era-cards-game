---
import Navbar from "../layout/Navbar.astro";
import Layout from "../layout/Layout.astro";
import Jeu from "../jeu/Jeu";
import CarteItem from "../cartes/ListeCarte/CarteItem/CarteItem.astro";
import SvgBranches from "../ressources/svg/SvgBranches.astro";
import SvgEnergie from "../ressources/svg/SvgEnergie.astro";
import SvgData from "../ressources/svg/SvgData.astro";
import SvgCarte from "../cartes/svg/SvgCarte.astro";
import { TOUTES_CARTES } from "../cartes/paquets/toutes.cartes";
import type { IdCartes } from "../cartes/paquets/IdCartes";

// Les composants Astro ne peuvent pas être utilisés dans un îlot : chaque carte
// de tous les paquets (base + évolutions) est rendue ici en HTML, l'îlot clone le modèle
// correspondant (voir `htmlCarte`, utilisé aussi bien pour la main que pour la révélation
// d'évolutions).
const ids = Object.keys(TOUTES_CARTES) as IdCartes[];
---

<Layout title="Jouer" disabledNavbar>
  <div hidden>
    <template data-modele-navbar>
      <Navbar currentPage="jouer" compact={true} boutonMenuJeu={true} />
    </template>
    <template data-modele-jeton-branche>
      <SvgBranches size="100%" fill="#062451" />
    </template>
    <template data-modele-chip-energie>
      <SvgEnergie size="100%" fill="#062451" />
    </template>
    <template data-modele-icone-data>
      <SvgData size="100%" fill="#062451" />
    </template>
    <template data-modele-icone-cartes-par-tour>
      <SvgCarte size="100%" fill="#fff" />
    </template>
    {
      ids.map((id) => (
        <template data-modele-carte={id}>
          <CarteItem {id} carte={TOUTES_CARTES[id]} />
        </template>
      ))
    }
  </div>
  <main>
    <Jeu client:only="preact" />
  </main>
</Layout>

<style is:global>
  body:has(main > astro-island) {
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding-bottom: 0;
    overflow: hidden;
  }
</style>

<style>
  main {
    flex: 1;
    min-height: 0;
  }
</style>
