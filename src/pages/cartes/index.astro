---
import Layout from "../../layout/Layout.astro";
import { TOUS_PAQUETS } from "../../cartes/paquets/tous.paquets";
import type { IdPaquets } from "../../cartes/paquets/IdPaquets";

const paquets = Object.keys(TOUS_PAQUETS) as IdPaquets[];
---

<Layout title="Les paquets">
  <div class="section">
    <h1>Les paquets</h1>
    <ul>
      {
        paquets.map((id) => (
          <li>
            <a href={`/cartes/${id}`}>{id}</a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
